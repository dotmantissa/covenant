# @privy-io/react-auth declares an optional peer on permissionless, which in
# turn wants ox ^0.8, while genlayer-js pulls viem with ox 0.14. npm refuses the
# tree even though nothing is actually broken: genlayer-js is server only, since
# every chain write is signed in a route handler, and Privy is browser only, so
# the two never land in the same bundle. permissionless itself is an account
# abstraction package this project does not use.
legacy-peer-deps=true
