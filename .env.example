# Copy to .env.local and fill in. Never commit .env.local.

# GenLayer
GENLAYER_NETWORK=studionet
GENLAYER_RPC_URL=https://studio.genlayer.com/api
GENLAYER_DEPLOYER_ACCOUNT=covenant-deployer
COVENANT_KEYSTORE_PASSWORD=

# Deployed contract addresses, filled in by the deploy step
NEXT_PUBLIC_FACILITY_REGISTRY_ADDRESS=
NEXT_PUBLIC_COVENANT_MONITOR_ADDRESS=
NEXT_PUBLIC_CREDIT_VAULT_ADDRESS=

# Neon Postgres
DATABASE_URL=

# Privy, email sign in. Only the app id is public.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Master secret the per user GenLayer keys are derived from. Server side only.
SIGNER_MASTER_SECRET=

# Used only to push, never read by the app
GITHUB_TOKEN=
